# --- Hermes -----------------------------------------------------------------
# URL interne du dashboard, telle que le conteneur du pont la joint.
HERMES_API_URL=http://hermes-dashboard:8080
HERMES_API_TOKEN=
# Gateway compatible OpenAI, pour l'outil `ask`. Laisser vide pour désactiver.
HERMES_GATEWAY_URL=http://hermes-gateway:4000
HERMES_GATEWAY_TOKEN=
HERMES_DEFAULT_BOARD=default
HERMES_DEFAULT_MODEL=
HERMES_TIMEOUT=60

# --- Cloudflare Access ------------------------------------------------------
# Domaine d'équipe (l'émetteur du JWT) et tag d'audience DE CETTE application.
# Sans le contrôle d'audience, un jeton émis pour une autre application du
# même compte passerait la validation.
ACCESS_TEAM_DOMAIN=https://mon-equipe.cloudflareaccess.com
ACCESS_AUD=
# Ne passer à false qu'en développement local.
ACCESS_VERIFY_JWT=true

# --- Transport HTTP ---------------------------------------------------------
BIND_HOST=0.0.0.0
BIND_PORT=8080
# Noms d'hôte publics servis par le tunnel, séparés par des virgules.
# Non renseignés, le SDK MCP rejette tout hôte non-loopback en 421.
PUBLIC_HOSTNAMES=agent.example.com
ALLOWED_ORIGINS=https://claude.ai
