# --- Hermes -----------------------------------------------------------------
# The dashboard's internal URL, as the bridge container reaches it.
HERMES_API_URL=http://hermes-dashboard:8080
HERMES_API_TOKEN=
# OpenAI-compatible gateway, for the `ask` tool. Leave empty to disable it.
HERMES_GATEWAY_URL=http://hermes-gateway:4000
HERMES_GATEWAY_TOKEN=
HERMES_DEFAULT_BOARD=default
HERMES_DEFAULT_MODEL=
HERMES_TIMEOUT=60

# --- Cloudflare Access ------------------------------------------------------
# Team domain (the JWT issuer) and the audience tag OF THIS application.
# Without the audience check, a token issued for another application on the
# same account would pass validation.
ACCESS_TEAM_DOMAIN=https://my-team.cloudflareaccess.com
ACCESS_AUD=
# Only set this to false for local development.
ACCESS_VERIFY_JWT=true

# --- HTTP transport ---------------------------------------------------------
BIND_HOST=0.0.0.0
BIND_PORT=8080
# Public hostnames served by the tunnel, comma-separated.
# Left empty, the MCP SDK rejects every non-loopback host with a 421.
PUBLIC_HOSTNAMES=agent.example.com
ALLOWED_ORIGINS=https://claude.ai
